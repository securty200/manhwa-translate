# ── AI Manga Translator — Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values.

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENV=development
DEBUG=true

# OCR
OCR_ENGINE=manga_ocr
OCR_DEVICE=cpu
OCR_BATCH_SIZE=4

# Text Detector
DETECTOR_MODEL=craft
DETECTOR_CONFIDENCE_THRESHOLD=0.5

# Translation — Choose one backend and set its API key
TRANSLATOR_BACKEND=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here

# Inpainting
INPAINTING_MODEL=lama
INPAINTING_DEVICE=cpu

# Database
DATABASE_ECHO=false

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
